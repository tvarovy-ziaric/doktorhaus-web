{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doktorhaus.sk/schemas/diagnostics/report-package.schema.json",
  "title": "DoktorHaus report package manifest",
  "description": "Manifest-only contract for an immutable, versioned client report package. Inspection, diagnosis and optional report-level pricing remain separate files referenced by checksum.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "report", "report_version", "actors", "files", "created_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "document_type": { "const": "report_package" },
    "report": { "$ref": "#/$defs/report" },
    "report_version": { "$ref": "#/$defs/report_version" },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/actor" }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/manifest_file" }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/date_time" }
  },
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inspection_id", "status", "current_published_version_id"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/report_id" },
        "inspection_id": { "$ref": "common.schema.json#/$defs/inspection_id" },
        "status": { "type": "string", "enum": ["draft", "active", "closed"] },
        "current_published_version_id": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/report_version_id" },
            { "type": "null" }
          ]
        }
      }
    },
    "report_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "report_id", "version", "change_type", "change_summary", "status", "generated_at",
        "renderer_contract_version", "limitations_snapshot", "unverified_items_snapshot"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/report_version_id" },
        "report_id": { "$ref": "common.schema.json#/$defs/report_id" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
        "change_type": { "type": "string", "enum": ["initial", "evidence_update", "follow_up", "post_repair", "material_revision"] },
        "change_summary": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "status": { "type": "string", "enum": ["draft", "in_review", "approved", "published", "superseded", "withdrawn"] },
        "generated_at": { "$ref": "common.schema.json#/$defs/date_time" },
        "approved_by": { "$ref": "common.schema.json#/$defs/actor_id" },
        "approved_at": { "$ref": "common.schema.json#/$defs/date_time" },
        "published_at": { "$ref": "common.schema.json#/$defs/date_time" },
        "renderer_contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "limitations_snapshot": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/non_empty_string" }
        },
        "unverified_items_snapshot": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/non_empty_string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["approved", "published", "superseded"] } },
            "required": ["status"]
          },
          "then": { "required": ["approved_by", "approved_at"] }
        },
        {
          "if": { "properties": { "status": { "const": "published" } }, "required": ["status"] },
          "then": { "required": ["published_at"] }
        },
        {
          "if": { "properties": { "change_type": { "const": "initial" } }, "required": ["change_type"] },
          "then": { "properties": { "version": { "const": "1.0" } } }
        }
      ]
    },
    "manifest_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "content_type", "privacy"],
      "properties": {
        "role": { "type": "string", "enum": ["inspection_data", "diagnosis_data", "report_pricing", "media", "attachment", "source_report", "other"] },
        "role_label": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "path": { "$ref": "common.schema.json#/$defs/relative_manifest_path" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "content_type": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "privacy": { "$ref": "common.schema.json#/$defs/privacy" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "other" } }, "required": ["role"] },
          "then": { "required": ["role_label"] }
        },
        {
          "if": { "properties": { "role": { "const": "report_pricing" } }, "required": ["role"] },
          "then": {
            "properties": {
              "content_type": { "const": "application/json" },
              "privacy": { "enum": ["client_private", "internal"] }
            }
          }
        }
      ]
    }
  }
}
